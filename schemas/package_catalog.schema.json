{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Harness Package Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_name", "vector_dim", "key_bits", "kernel", "promoted"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "catalog_name": {"type": "string"},
    "vector_dim": {"type": "integer", "minimum": 1},
    "key_bits": {"type": "integer", "minimum": 1},
    "kernel": {"type": "string"},
    "promoted": {"type": "array", "items": {"type": "object"}},
    "rejected": {"type": "array", "items": {"type": "object"}}
  }
}